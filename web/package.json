{
  "name": "unlxck-web",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "node --import tsx --import ./test/register-css-stub.mjs --test \"lib/**/*.test.ts\" \"components/**/*.test.ts\" \"components/**/*.test.tsx\"",
    "test:i18n": "node --test scripts/i18n-catalog.test.mjs && node scripts/i18n-check.mjs",
    "i18n:check": "node scripts/i18n-check.mjs",
    "i18n:sync": "node --env-file-if-exists=.env.local scripts/i18n-sync.mjs",
    "test:e2e": "playwright test",
    "audit:high": "npm audit --audit-level=high --omit=dev"
  },
  "dependencies": {
    "@sentry/nextjs": "10.76.2",
    "@supabase/supabase-js": "2.99.1",
    "next": "16.4.5",
    "next-intl": "^4.14.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zxcvbn": "4.4.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.3",
    "@playwright/test": "1.60.0",
    "@types/jsdom": "^28.0.3",
    "@types/node": "24.12.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/zxcvbn": "4.4.5",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.5",
    "jsdom": "^25.0.1",
    "tsx": "^4.23.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "fast-uri": "^3.1.8",
    "sharp": "^0.35.5",
    "postcss": "^8.5.12",
    "brace-expansion@5": "^5.0.12",
    "browserslist": "^4.28.8"
  },
  "engines": {
    "node": "24.x"
  }
}
